    {"id": "clap", "label": "Clap", "voice": "noise", "params": {"filter": "bandpass", "freq": 1200, "decay": 0.18, "bursts": 3}},
    {"id": "hat", "label": "Closed hat", "voice": "noise", "params": {"filter": "highpass", "freq": 7000, "decay": 0.05}},
