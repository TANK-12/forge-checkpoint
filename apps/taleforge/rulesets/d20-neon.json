  "classes": [
    {
      "id": "street_samurai", "name": "Street Samurai", "hit_die": 10, "primary": "str",
      "about": "More chrome than meat, a blade on the hip and reflexes bought on credit. Hard to kill, steady in a fight.",
      "skill_options": ["athletics", "parkour", "intimidation", "perception", "drive", "streetwise", "insight"], "skill_count": 2,
      "start_items": ["mono_katana", "kevlar_vest", "stim_shot", "stim_shot"], "start_gold": 15,
      "abilities": [
        {"id": "adrenal_booster", "name": "Adrenal Booster", "level": 1, "kind": "heal", "amount": "1d10+level", "uses": 1, "per": "short", "text": "A pump in your chest kicks, and the pain goes somewhere far away."},
        {"id": "kerenzikov_burst", "name": "Reflex Burst", "level": 2, "kind": "extra_attack", "uses": 1, "per": "short", "text": "The world slows to syrup and you cut twice before it catches up."},
        {"id": "wired_reflexes", "name": "Wired Reflexes", "level": 5, "kind": "passive", "attacks": 2, "text": "Your boosted nerves let you attack twice with each Attack."},
        {"id": "subdermal_lock", "name": "Subdermal Lockdown", "level": 9, "kind": "guard", "ac": 4, "rounds": 2, "uses": 1, "per": "long", "text": "Armour plates slide shut under your skin. Nothing gets through."}
      ]
    },
    {
      "id": "ghost", "name": "Ghost", "hit_die": 8, "primary": "dex",
      "about": "An infiltrator who was never there: quiet shoes, a suppressed pistol and a knife for the first strike. Expert at skills.",
      "skill_options": ["parkour", "athletics", "deception", "insight", "intimidation", "investigation", "perception", "performance", "persuasion", "sleight", "stealth", "streetwise"], "skill_count": 4,
      "expertise": 2,
      "start_items": ["combat_knife", "silenced_pistol", "armored_jacket", "lockbreaker", "stim_shot"], "start_gold": 25,
      "abilities": [
        {"id": "blindside", "name": "Blindside", "level": 1, "kind": "passive", "bonus_damage": "1d6", "scale": {"3": "2d6", "5": "3d6", "7": "4d6", "9": "5d6"}, "once_per_round": true, "text": "Your first hit each round lands where they never saw it coming."},
        {"id": "optical_camo", "name": "Optical Camo", "level": 2, "kind": "advantage", "uses": 2, "per": "short", "text": "Your outline smears into the rain; your next attack or check has advantage."},
        {"id": "monowire_lash", "name": "Monowire Lash", "level": 3, "kind": "damage", "damage": "2d6+2", "uses": 1, "per": "short", "text": "A wire too thin to see whips out of your wrist and through them."},
        {"id": "ghost_step", "name": "Ghost Step", "level": 5, "kind": "guard", "ac": 3, "rounds": 1, "uses": 2, "per": "short", "text": "You are simply not where the shot goes."}
      ]
    },
    {
      "id": "netrunner", "name": "Netrunner", "hit_die": 6, "primary": "int",
      "about": "Fragile, clever and dangerous. A cyberdeck, a head full of daemons, and every camera in the block on your side.",
      "skill_options": ["hacking", "tech", "investigation", "insight", "medicine", "streetwise"], "skill_count": 2,
      "start_items": ["heavy_pistol", "cyberdeck", "armored_jacket", "stim_shot"], "start_gold": 15,
