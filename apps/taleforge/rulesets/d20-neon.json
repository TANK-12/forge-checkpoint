        {"id": "short_circuit", "name": "Short Circuit", "level": 1, "kind": "attack", "ability": "int", "damage": "1d10", "scale": {"5": "2d10", "9": "3d10"}, "text": "You ping their chrome and it bites back."},
        {"id": "synapse_burn", "name": "Synapse Burn", "level": 1, "kind": "damage", "damage": "3d4+3", "uses": 2, "per": "long", "text": "A quickhack straight into the nervous system. It never misses."},
        {"id": "firewall_shell", "name": "Firewall Shell", "level": 1, "kind": "guard", "ac": 5, "rounds": 1, "uses": 2, "per": "long", "text": "Every smart round in the room suddenly forgets where you are."},
        {"id": "daemon_cascade", "name": "Daemon Cascade", "level": 2, "kind": "area", "damage": "3d6", "save": "int", "uses": 2, "per": "long", "text": "You drop a daemon into the local net and every implant in range seizes."},
        {"id": "system_reset", "name": "System Reset", "level": 3, "kind": "restore", "restores": ["synapse_burn", "daemon_cascade"], "uses": 1, "per": "long", "text": "You flush your buffers and reload your best scripts."},
